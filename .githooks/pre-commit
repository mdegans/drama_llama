#!/usr/bin/env bash
#
# Installed by `just install-hooks`, which points core.hooksPath here — so this
# file is versioned and every clone gets the same gate with one command.
#
# Two gates, both cheap enough to sit in front of every commit:
#
#   1. `just check` — rustfmt is clean (the whole tree, not just the diff — a
#      formatter is only useful if the tree is a fixed point of it), rustdoc is
#      clean (broken/private intra-doc links promoted to hard errors), and the
#      doctests pass. The doc build reuses the test build's artifacts, so it's
#      a rustdoc pass, not a recompile; the doctests add ~2s on top and are
#      here because nextest cannot run them, so gate 2 runs exactly zero.
#   2. `just test` — the unignored test suite passes.
#
# The #[ignore]'d tests are deliberately NOT run: they load 13-18 GB models
# onto a GPU and take minutes. Those are `just test ignored` (or `just test
# all` for those plus these), run by hand.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Non-Rust commits (memory notes, docs, fixtures) skip both checks — nothing
# they touch can break a build, and a docs typo shouldn't cost a test run.
#
# README.md is the exception, and it is why this list is not just "*.rs":
# `src/lib.rs` mounts it as the crate-level documentation with `include_str!`,
# so its ```rust blocks are doctests that `just check` compiles and runs. A
# README edit really can turn the tree red, and skipping the gate for it would
# let that reach CI.
#
# TERMS_OF_USE.md is `include_str!`d too (as `drama_llama::TOS`) and is
# deliberately absent: it carries prose, not code. An edit changes one string
# constant, which nothing validates and no test can fail on. Same rule as
# ci.yml's `paths` filter, for the same reason.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! grep -qE '(\.rs$|^Cargo\.(toml|lock)$|^justfile$|^rustfmt\.toml$|^README\.md$)' <<<"$staged"; then
    echo "pre-commit: no Rust/build changes staged — skipping fmt + tests"
    exit 0
fi

echo "pre-commit: just check (rustfmt + rustdoc)"
if ! just check; then
    echo >&2
    echo "pre-commit: FAILED — tree is not fmt/doc-clean (see above)." >&2
    echo "pre-commit:   \`just fmt\` fixes formatting; fix or de-link a broken doc link for rustdoc." >&2
    exit 1
fi

echo "pre-commit: just test (unignored)"
if ! just test; then
    echo >&2
    echo "pre-commit: FAILED — unignored tests are red." >&2
    echo "pre-commit: full log in target/test-logs/unignored.log" >&2
    exit 1
fi


echo "pre-commit: ok"
